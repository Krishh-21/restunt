# Copy to .env for local use. Never commit live credentials.
DATABASE_URL=postgresql://dinely:local-development-only@localhost:5432/dinely
DIRECT_URL=postgresql://dinely:local-development-only@localhost:5432/dinely
POSTGRES_PASSWORD=local-development-only
REDIS_URL=redis://localhost:6379
PORT=5000
NODE_ENV=development
JWT_SECRET=local-development-secret-replace-before-deploying
CORS_ORIGIN=http://localhost:5000,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
# Configure separately in each Vite app's environment when hosted cross-origin.
VITE_API_URL=http://localhost:5000
PUBLIC_STOREFRONT_URL=http://localhost:5000/store/
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Integration tests run only against a dedicated database ending in _test.
# Set DATABASE_URL and INTEGRATION_DATABASE_URL to the same test database URL.
INTEGRATION_DATABASE_URL=

# Reusable single-host deployment; only PUBLIC_API_URL reaches runtime browser config.
SERVE_FRONTENDS=false
PUBLIC_API_URL=
TRUST_PROXY=0
# Encrypted backups: a 64-hex-character key, generated once and kept separately.
BACKUP_ENABLED=false
BACKUP_ENCRYPTION_KEY=
BACKUP_DIRECTORY=
BACKUP_CRON=0 2 * * *
PG_DUMP_BIN=pg_dump
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
# AWS uses its standard credential chain / instance role. Explicit keys are optional.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FIREBASE_SERVICE_ACCOUNT_PATH=

# One-time restaurant provisioning. Remove the initial password after setup.
INITIAL_RESTAURANT_NAME=
INITIAL_RESTAURANT_SLUG=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=

# Structured API request logging: error, warn, info, debug
LOG_LEVEL=info
