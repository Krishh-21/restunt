# Database - Connection Pooling Configuration
# Development Database URLs
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dinely?pgbouncer=true&connection_limit=20&pool_timeout=20&statement_cache_size=0
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/dinely

# Production Database URLs (replace with actual values)  
# Recommended: Use connection pooling service like Supabase, Railway, or PgBouncer
# DATABASE_URL=postgresql://username:password@hostname:5432/database?pgbouncer=true&connection_limit=100&pool_timeout=30&statement_cache_size=0&prepared_statements=false
# DIRECT_URL=postgresql://username:password@hostname:5432/database

# Connection Pool Settings (for non-pooled connections)
# PRISMA_CLIENT_MAX_CONNECTIONS=10
# PRISMA_CLIENT_CONNECTION_TIMEOUT=30000

# API
PORT=5000
JWT_SECRET=dev-secret-change-in-production
NODE_ENV=development

# Redis (optional for now)
REDIS_URL=redis://localhost:6379
